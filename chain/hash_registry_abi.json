[
  {
    "type": "function",
    "name": "commit",
    "inputs": [
      { "name": "recordId", "type": "string" },
      { "name": "resultHash", "type": "bytes32" }
    ],
    "outputs": [],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "get",
    "inputs": [{ "name": "recordId", "type": "string" }],
    "outputs": [
      { "name": "resultHash", "type": "bytes32" },
      { "name": "committedAt", "type": "uint256" },
      { "name": "exists", "type": "bool" }
    ],
    "stateMutability": "view"
  },
  {
    "type": "function",
    "name": "verify",
    "inputs": [
      { "name": "recordId", "type": "string" },
      { "name": "expectedHash", "type": "bytes32" }
    ],
    "outputs": [{ "name": "", "type": "bool" }],
    "stateMutability": "view"
  },
  {
    "type": "event",
    "name": "HashCommitted",
    "anonymous": false,
    "inputs": [
      { "name": "recordId", "type": "string", "indexed": true },
      { "name": "resultHash", "type": "bytes32", "indexed": false },
      { "name": "committedAt", "type": "uint256", "indexed": false }
    ]
  },
  {
    "type": "error",
    "name": "EmptyRecordId",
    "inputs": []
  },
  {
    "type": "error",
    "name": "EmptyResultHash",
    "inputs": []
  },
  {
    "type": "error",
    "name": "AlreadyCommitted",
    "inputs": [{ "name": "recordId", "type": "string" }]
  }
