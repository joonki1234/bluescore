# Global Fishing Watch API
GFW_API_KEY=

# 공공데이터포털 - 선박제원정보
VESSEL_SPEC_API_KEY=

# 공공데이터포털 - 연안 AIS 통계
COASTAL_AIS_API_KEY=

# 공공데이터포털 - TAC 소진현황
TAC_STATUS_API_KEY=

# 해양기상 API
MARINE_WEATHER_API_KEY=

# 카카오맵 API
KAKAO_API_KEY=

# ─── 설명 계층 (explain/) ───────────────────────────────────────────────
# 기본 LLM 프로바이더. 사용 가능: openai / alan / alan+openai
BLUESCORE_LLM_PROVIDER=openai

# 흐름별 덮어쓰기. 걸지 않으면 위 기본값을 쓴다.
# 흐름: EXPLAIN(요약) / QA(질의응답) / OBJECTION(이의제기) / REPORT(상세리포트) / TIP(개선 팁)
#
# 현재 배치는 OpenAI와 앨런 프로바이더 구현·테스트.
# 다시 붙이려면 아래 주석만 풀면 되고 코드는 손대지 않아도 된다.
#   BLUESCORE_LLM_PROVIDER__TIP=alan+openai
# 단 QA에는 걸지 말 것 — 앨런은 URL 길이 한도 때문에 참고 사실 블록을
# 실을 수 없어서 금어기 같은 제도 질문에 근거 없이 답하게 된다.

# 런타임 LLM 호출 스위치. false면 질의응답·이의제기 답변이 LLM을 아예 부르지
# 않고 템플릿 문구로 나간다(화면에 llm_disabled로 표시). 시연에서는 true.
BLUESCORE_LLM_RUNTIME_ENABLED=true

# OpenAI (기본 프로바이더이자 앨런의 강등 대상. 사실상 필수)
OPENAI_API_KEY=
# 모델 변경 시. 기본 gpt-4o-mini
BLUESCORE_LLM_MODEL=

# 이스트소프트 앨런. 콤마로 여러 키를 넣으면 앞에서부터 쓰고,
# 사용량이 소진되면(401) 자동으로 다음 키로 넘어간다.
#   ALAN_API_KEY=키1,키2
ALAN_API_KEY=

# ─── 애플리케이션 상태 저장 ─────────────────────────────────────────────
# 비우면 bluescore/instance/bluescore_demo.db 사용
BLUESCORE_DB_PATH=

# 위 데이터 수집 키는 배치 수집 환경 전용이다. FastAPI와 Streamlit 프론트는
# 발표 중 외부 데이터 API를 호출하지 않고 버전 고정 로컬 스냅샷만 읽는다.
